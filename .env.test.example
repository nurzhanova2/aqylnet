# Reference env for running the automated test suites in tests/.
# Nothing loads this file: tests/ has no dotenv and reads only the environment
# of the process that runs them. Set the values in the terminal you run the
# suites from — never commit real secrets here or anywhere else in the repo.

# ── What the tests themselves read ────────────────────────────
#
# Reach the backend and Postgres over IPv4: on this machine localhost resolves
# to ::1, where an unrelated project's dev server listens, while docker
# publishes on 127.0.0.1 only.
API_BASE_URL=http://127.0.0.1:3001/api
APP_URL=http://127.0.0.1:8080

# Direct Postgres access for the few assertions with no HTTP surface
# (tests/api/db.mjs: advisory locks, LlmUsage rows, stored document text).
# Required: there is no default any more. db.mjs used to fall back to
# postgres:postgres@localhost, which reaches the same docker Postgres and fails
# with 28P01 "password authentication failed" — a missing variable that looked
# like a wrong password. The password is POSTGRES_PASSWORD from the root .env.
TEST_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5432/aqylnet?schema=public
#
# Setting it. The variable lives only in the current terminal window: a new
# window, a new VS Code terminal or another shell does not see it.
#
#   PowerShell:
#     $env:TEST_DATABASE_URL = 'postgresql://postgres:<password>@127.0.0.1:5432/aqylnet?schema=public'
#     $env:API_BASE_URL = 'http://127.0.0.1:3001/api'
#
#   bash / Git Bash — with export, otherwise node --test does not inherit it:
#     export TEST_DATABASE_URL='postgresql://postgres:<password>@127.0.0.1:5432/aqylnet?schema=public'
#     export API_BASE_URL='http://127.0.0.1:3001/api'
#
# Check without printing the value:
#   node -e "console.log(Boolean(process.env.TEST_DATABASE_URL))"

# ── The backend under test ────────────────────────────────────
#
# The live suites drive far more LLM-route requests in five minutes than any
# single human session, so they trip the production rate limits (one full
# discussion is ~12 requests; the suites run dozens). Widen the limits for the
# backend under test instead of lowering them in the code: put these in the
# root .env (compose reads it) and run `docker compose up -d backend`; remove
# them and run it again once the run is finished. A 429 in the middle of a
# suite is the limiter working, not a regression.
RATE_LIMIT_MAX=100000
RATE_LIMIT_LLM_MAX=100000
RATE_LIMIT_LLM_GLOBAL_MAX=100000
RATE_LIMIT_UPLOAD_MAX=100000
#
# The backend's own DATABASE_URL, LLM_API_KEY, LLM_API_BASE and LLM_MODEL come
# from the root .env through compose (see .env.example) — the tests do not
# read them.
