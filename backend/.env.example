# backend/.env — только для запуска backend напрямую на хосте, без Docker.
#
# Секретов здесь нет и быть не должно: LLM_API_KEY, LLM_API_BASE и LLM_MODEL
# живут в корневом .env (см. ../.env.example), а config/env.ts читает его как
# источник по умолчанию. Один ключ — один файл: раньше живой ключ лежал в обоих,
# то есть ротация требовала двух правок, и пропущенная оставляла старый ключ
# рабочим в том пути, про который забыли.
#
# Значение, заданное здесь, всё равно перекрывает корневое — файл для
# host-специфичных отличий, а не для дублирования.

# Единственное исключение по паролю: хостовый DSN указывает на localhost, а не
# на внутреннюю сеть compose, поэтому собрать его из корневого POSTGRES_PASSWORD
# нельзя — пароль Postgres здесь неизбежен. Ротация пароля — три места:
# корневой .env, эта строка и ALTER USER на существующем томе.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aqylnet?schema=public"

# Сервер
PORT=3001
NODE_ENV=development

# CORS — origin dev-сервера фронтенда. Тонкому фронтенду (nginx) не нужен:
# он same-origin. Список через запятую.
CORS_ORIGIN=http://localhost:5174

# Загрузки
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
