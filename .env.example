# Корневой .env — ЕДИНСТВЕННОЕ место, где лежат секреты.
#
# Читается двумя потребителями:
#   1. docker-compose.yml — подстановка ${…};
#   2. backend/src/config/env.ts — как источник по умолчанию для хостового
#      запуска (значение из backend/.env, если оно там есть, имеет приоритет).
#
# Этого файла раньше не было, хотя compose без него не поднимается:
# `${POSTGRES_PASSWORD:?}` падает, а `${LLM_API_KEY}` разворачивается в пустую
# строку — то есть backend стартует и краснеет на health. Скопируйте в `.env`
# и заполните. Реальный `.env` не коммитить (он в .gitignore).

# ── Postgres ───────────────────────────────────────────────────
# Действует только при ПЕРВОМ initdb. На уже созданном томе смена этой строки
# ничего не меняет — нужен `ALTER USER postgres WITH PASSWORD`.
POSTGRES_PASSWORD=

# ── LiteLLM ────────────────────────────────────────────────────
# Токен и модель меняются вместе: новый токен авторизован только на capability
# alias, старый — только на конкретное имя модели, и перепутанная пара даёт 403
# key_model_access_denied на каждом вызове. Проверка пары до того, как ей
# доверять: scripts/check-llm-model.mjs (запускать из контейнера).
LLM_API_KEY=
LLM_API_BASE=https://prod-litellm.nationalbank.kz
LLM_MODEL=assistant-balanced

# ── Необязательное: лимиты и бюджеты ──────────────────────────
# Дефолты — в backend/src/config/limits.ts и config/env.ts. Переопределять
# окружением, а не правкой кода: прогон тестов требует расширенных лимитов,
# и ослаблять их в коде ради прогона нельзя.
#
# TRUST_PROXY=1
# RATE_LIMIT_MAX=300
# RATE_LIMIT_LLM_MAX=40
# RATE_LIMIT_LLM_GLOBAL_MAX=150
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LLM_WINDOW_MS=300000
# RATE_LIMIT_UPLOAD_WINDOW_MS=300000
# DOCUMENT_PARSE_TIMEOUT_MS=20000
# DOCUMENT_PARSE_MAX_HEAP_MB=512
# LLM_DISABLE_THINKING=true
#
# max_tokens по сценариям и окно модели. Свободный текст (PERSONA, MODERATOR)
# без замера не поднимать: эта модель выбирает весь бюджет, и подъём меняет
# длину реплик. Пустое значение = дефолт из limits.ts.
# LLM_MAX_TOKENS_SUGGEST=1024
# LLM_MAX_TOKENS_POSITIONS=4096
# LLM_MAX_TOKENS_PERSONA=300
# LLM_MAX_TOKENS_MODERATOR=150
# LLM_MAX_TOKENS_REPORT=3072
# LLM_MAX_TOKENS_AUDIT=3072
# LLM_MAX_TOKENS_ALIGNMENT=2048
# LLM_MAX_TOKENS_CHECKLIST=1536
# LLM_MAX_TOKENS_CONTRADICTIONS=2048
# LLM_MAX_TOKENS_PERSONA_SCORE=6144
# LLM_MAX_TOKENS_DECISION_REFERENCE=512
# LLM_MAX_TOKENS_DECISION_VERDICTS=1024
# LLM_MAX_TOKENS_MISSING=1536
# LLM_MAX_TOKENS_REWRITE_CARD=1024
# LLM_MAX_TOKENS_REWRITE_BRIEF=3072
# LLM_MAX_TOKENS_REWRITE_BLUF=768
# LLM_MAX_TOKENS_REWRITE_SECTION=3072
# LLM_CONTEXT_TOKENS=49152
# LLM_PERSONA_SCORE_TIMEOUT_MS=180000
# AUDIT_CONTRADICTIONS=false
#
# LLM_DAILY_TOKEN_BUDGET=10000000
# LLM_DAILY_SUGGEST_CALLS=200
# LLM_REQUEST_TIMEOUT_MS=45000
# MAX_CONCURRENT_ROUNDS=6
#
# Наполнить библиотеку персон на чистой базе — один раз:
# RUN_SEED=true
